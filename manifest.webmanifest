{
  "name": "SworfishGuard",
  "short_name": "SworfishGuard",
  "description": "Revisa contraseñas, enlaces, mensajes, códigos QR, correos y fotos antes de confiar. Todo en tu navegador.",
  "lang": "es",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
